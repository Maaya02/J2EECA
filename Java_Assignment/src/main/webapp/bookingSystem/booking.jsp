	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
		integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
		crossorigin="anonymous"></script>

	<script>
        document.addEventListener('DOMContentLoaded', function () {
			let dateInput = document.getElementById("date")
			let now = new Date()
			const year = now.getFullYear().toString();
			let month = now.getMonth() + 1
			let day = now.getDate()
			console.log(month)
			if (month < 10){
				month = (now.getMonth() + 1).toString().padStart(2, '0');
			} else {
				month = month.toString()
			}
			if (day < 10) {
				now.getDate().toString().padStart(2, '0');
			} else {
				day = day.toString()
			}
			let minDate = year + "-"+month+"-"+day
			console.log(minDate)
			dateInput.setAttribute("min",minDate)
        });
        function addCaregiverMenu(){
        	let select = document.getElementById("caregivers");
        	let htmlForSelect = "<option hidden>Select...</option>"
        	fetch("http://localhost:8080/Java_Assignment/getCaregivers")
        	.then(response => response.json())
        	.then((result)=>{
        		result.forEach((result=>{
        			htmlForSelect+= "<option value='" + result.caregiver_id + "'>" + result.caregiver_name + "</option>";
        		}))
				select.innerHTML = htmlForSelect
        	})
        }
        function addSelectMenu(){
            let select = document.getElementById("services");
            let services = document.querySelectorAll('input[name="service"]');
            let serviceType = ""
            for (let i = 0; i < services.length; i++){
            	if (services[i].checked == true){
            		serviceType = services[i].value
            	}
            }
            let html = `
                <option hidden>Select...</option>
                `
            fetch("http://localhost:8080/Java_Assignment/getServices?serviceType="+serviceType)
            .then(response => response.json())
            .then(result =>{
				result.forEach((result)=>{
					html+= "<option value='" + result.service_id + "'>" + result.service_name + "</option>";
				})
				select.innerHTML = html
            })
        }
    </script>

